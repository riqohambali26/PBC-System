{
  "brand": "Fiscorex",
  "color": {
    "brand-green": { "value": "#0B4A33", "use": "Logo wordmark, accent headings, brand links" },
    "navy": { "value": "#14213A", "use": "Primary CTA background, footer background" },
    "navy-hover": { "value": "#1D2E50", "use": "CTA hover (web clients only)" },
    "canvas": { "value": "#E9EDF4", "use": "Outer page background behind the email" },
    "surface": { "value": "#F8F8F4", "use": "Email body background" },
    "header": { "value": "#F8F8F4", "use": "Header band background" },
    "border": { "value": "#DDDDD6", "use": "Header divider, hairlines" },
    "text": { "value": "#111111", "use": "Body copy" },
    "text-muted": { "value": "#5B6475", "use": "Secondary copy, captions" },
    "on-navy": { "value": "#FFFFFF", "use": "Text on navy (button label)" },
    "footer-text": { "value": "#8591A8", "use": "Footer body text on navy" },
    "footer-muted": { "value": "#66738C", "use": "Footer tertiary lines" },
    "footer-link": { "value": "#8591A8", "use": "Footer links (underlined)" },
    "success": { "value": "#C0392B", "use": "Reserved: check-mark red inside logo only" }
  },
  "font": {
    "family": "Verdana, 'DejaVu Sans', Geneva, Tahoma, sans-serif",
    "size": { "body": "16px", "small": "12px", "button": "16px", "h1": "24px", "h2": "20px" },
    "weight": { "regular": 400, "medium": 500, "bold": 700 },
    "line-height": { "body": "1.55", "heading": "1.3", "small": "1.6" }
  },
  "space": { "xs": "8px", "sm": "12px", "md": "16px", "lg": "24px", "xl": "32px", "xxl": "40px" },
  "layout": {
    "email-width": "600px",
    "content-padding-x": "40px",
    "content-padding-x-mobile": "20px",
    "header-padding-y": "24px",
    "footer-padding": "32px 40px"
  },
  "radius": { "button": "8px", "card": "8px" },
  "button": {
    "height": "48px",
    "padding": "14px 28px",
    "background": "#14213A",
    "color": "#FFFFFF",
    "font-weight": 500
  },
  "mergeTags": {
    "firstName": "{{contact.first_name}}",
    "senderName": "John Krowiak",
    "phone": "+1 888-493-2881"
  }
}
